# ===== COPY THIS FILE TO .env AND FILL IN YOUR VALUES =====

# Admin account (used to seed the admin user)
ADMIN_EMAIL=myselfsubhamkumar@gmail.com
ADMIN_PASSWORD=admin@123

# Port the server runs on
PORT=3000

# Local SQLite DB path (dev only — production uses Supabase)
DB_PATH=./notes-app.db

# ===== SUPABASE (PERMANENT CLOUD STORAGE — REQUIRED FOR DEPLOYED APP) =====
# Create a free project at https://supabase.com
# Project URL (Settings → API → Project URL):
SUPABASE_URL=https://YOURPROJECT.supabase.co

# Service role key (Settings → API → service_role secret)
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

